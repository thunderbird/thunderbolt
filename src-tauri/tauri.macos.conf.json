{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Thunderbolt",
        "width": 1400,
        "height": 1000,
        "minHeight": 600,
        "minWidth": 500,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "followsWindowActiveState"
        },
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 26
        }
      },
      {
        "label": "quick-entry",
        "url": "quick-entry.html",
        "title": "Quick Entry",
        "width": 680,
        "height": 88,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "macOSPrivateApi": true
  }
}
