---
// This Source Code Form is subject to the terms of the Mozilla Public
// License, v. 2.0. If a copy of the MPL was not distributed with this
// file, You can obtain one at http://mozilla.org/MPL/2.0/.
import BaseLayout from './BaseLayout.astro';

type Props = {
	title: string;
	description: string;
	date: Date;
	author: string;
	tags: string[];
	image?: string;
};

const { title, description, date, author, tags, image } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description} ogType="article" ogImage={image ? new URL(image, Astro.site ?? Astro.url).href : undefined}>
	<article>
		<header class="post-header">
			<a class="back-link" href="/blog/">← Back to the blog</a>
			<h1>{title}</h1>
			<p class="meta">
				<span class="author">{author}</span>
				<span class="sep">&middot;</span>
				<time datetime={date.toISOString()}>{formattedDate}</time>
			</p>
		</header>
		{image && <img src={image} alt="" class="cover" />}
		<div class="prose">
			<slot />
		</div>
		<footer class="post-footer">
			<div class="tags">{tags.map((tag) => <span class="tag">{tag.replaceAll('-', ' ')}</span>)}</div>
			<a class="back-link" href="/blog/">More from Thunderbolt →</a>
		</footer>
	</article>
</BaseLayout>

<style>
	article { max-width: 900px; margin-inline: auto; }
	.post-header { max-width: 800px; margin: 0 auto 48px; }
	.back-link { color: var(--spark-red); font-size: 14px; text-decoration: none; }
	.back-link:hover { text-decoration: underline; text-underline-offset: 4px; }
	.post-header h1 { font-size: clamp(34px, 4.6vw, 58px); line-height: 1.12; letter-spacing: -.045em; font-weight: 500; margin: 36px 0 28px; text-wrap: pretty; }
	.meta { color: var(--spark-muted); font-size: 14px; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0; line-height: 1.6; }
	.meta .author { color: var(--spark-ink); font-weight: 500; }
	.tags { display: flex; flex-wrap: wrap; gap: 8px; }
	.tag { font-size: 12px; color: var(--spark-muted); background: var(--spark-hover); border-radius: 50px; padding: 6px 12px; }
	.cover { display: block; border-radius: 18px; width: 100%; height: auto; margin-bottom: 56px; border: 1px solid var(--spark-border); }
	.prose, .post-footer { max-width: 700px; margin-inline: auto; }
	.post-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; margin-top: 64px; border-top: 1px solid var(--spark-border); padding-top: 32px; }
	@media (max-width: 760px) {
		.post-header { margin-bottom: 36px; }
		.post-header h1 { margin-top: 28px; }
		.cover { margin-bottom: 36px; border-radius: 12px; }
	}

	/* ─── Editorial prose ─── */
	.prose {
		font-family: var(--tb-font-sans);
		color: var(--tb-text-secondary);
		font-size: 1.0625rem;
		line-height: 1.75;
	}

	.prose :global(p) {
		margin-top: 1.5em;
		margin-bottom: 0;
	}

	.prose :global(p:first-child) {
		margin-top: 0;
	}

	.prose :global(h2) {
		margin-top: 2.5em;
		margin-bottom: 0.75em;
		font-size: 1.5rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--tb-text);
	}

	.prose :global(h3) {
		margin-top: 2em;
		margin-bottom: 0.5em;
		font-size: 1.1875rem;
		font-weight: 500;
		color: var(--tb-text);
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin-top: 1.25em;
		margin-bottom: 0;
		padding-left: 1.5em;
	}

	.prose :global(ul) {
		list-style: disc;
	}

	.prose :global(li) {
		margin-top: 0.5em;
	}

	.prose :global(li + li) {
		margin-top: 0.75em;
	}

	.prose :global(strong) {
		font-weight: 600;
		color: var(--tb-text);
	}

	.prose :global(a) {
		color: var(--tb-brand);
		text-decoration: none;
		border-bottom: 1px solid color-mix(in srgb, var(--tb-text-muted) 40%, transparent);
		transition:
			color 0.15s,
			border-color 0.15s;
	}

	.prose :global(a:hover) {
		color: var(--tb-text);
		border-color: var(--tb-text);
	}

	.prose :global(code) {
		background: var(--tb-surface-input);
		border: 1px solid var(--tb-border);
		padding: 0.05em 0.35em;
		font-family: var(--tb-font-mono);
		font-size: 0.85em;
		color: var(--tb-text);
	}

	.prose :global(pre) {
		background: var(--tb-surface);
		border: 1px solid var(--tb-border);
		padding: 1.15rem 1.25rem;
		overflow-x: auto;
		margin: 1.5em 0;
		font-size: 0.875rem;
		border-radius: 12px;
		line-height: 1.55;
	}

	.prose :global(pre code) {
		background: none;
		border: 0;
		padding: 0;
		color: var(--tb-text);
		font-size: inherit;
	}

	.prose :global(blockquote) {
		margin: 2em 0 0;
		border-left: 3px solid var(--spark-red);
		padding-left: 1.25em;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--tb-text);
		font-style: italic;
	}

	.prose :global(blockquote cite) {
		display: block;
		margin-top: 0.75em;
		font-style: normal;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--tb-text-muted);
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 12px;
		border: 1px solid var(--tb-border);
	}

	.prose :global(hr) {
		margin: 2.5em 0;
		border: 0;
		border-top: 1px solid var(--tb-border);
	}
</style>
