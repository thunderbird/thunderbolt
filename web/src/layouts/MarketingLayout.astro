import '../styles/marketing.css';
import SiteHead from '../components/SiteHead.astro';

type Props = {
	title?: string;
	description?: string;
	ogImage?: string;
	canonical?: string;
};

const {
	title = 'Thunderbolt — AI You Control',
	description = 'The Open-Source, Cross-Platform, Extensible AI Client',
	ogImage = 'https://thunderbolt.io/social.png',
	canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead {title} {description} {ogImage} {canonical} />

		<script is:inline>
			var _paq = (window._paq = window._paq || []);
			_paq.push(['setCookieDomain', '*.thunderbolt.io']);
			_paq.push(['trackPageView']);
			_paq.push(['enableLinkTracking']);
			(function () {
				var u = 'https://thunderbird.innocraft.cloud/';
				_paq.push(['setTrackerUrl', u + 'matomo.php']);
				_paq.push(['setSiteId', '6']);
				var d = document,
					g = d.createElement('script'),
					s = d.getElementsByTagName('script')[0];
				g.async = true;
				g.src = 'https://cdn.matomo.cloud/thunderbird.innocraft.cloud/matomo.js';
				s.parentNode.insertBefore(g, s);
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
