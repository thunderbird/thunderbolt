#. js-lingui-explicit-id
#: src/emails/email-layout.tsx
msgid "Questions?"
msgstr "¿Tienes dudas?"

#. js-lingui-explicit-id
#: src/emails/email-layout.tsx
msgid "You can reply to this email"
msgstr "Puedes responder a este correo"

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Your Thunderbolt verification code"
msgstr "Tu código de verificación de Thunderbolt"

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Sign in to Thunderbolt"
msgstr "Inicia sesión en Thunderbolt"

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Use the code below to sign in, or click the button."
msgstr "Usa el código de abajo para iniciar sesión, o haz clic en el botón."

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Sign In"
msgstr "Iniciar sesión"

#. js-lingui-explicit-id
#: src/emails/waitlist-joined.tsx
#: src/emails/waitlist-not-ready.tsx
msgid "You're on the Thunderbolt waitlist!"
msgstr "¡Estás en la lista de espera de Thunderbolt!"

#. js-lingui-explicit-id
#: src/emails/waitlist-joined.tsx
msgid "Thanks for signing up!"
msgstr "¡Gracias por registrarte!"

#. js-lingui-explicit-id
#: src/emails/waitlist-joined.tsx
msgid "You've been added to the Thunderbolt waitlist. We're working hard to get you access as soon as possible. We'll send you another email when it's your turn to join."
msgstr "Te hemos añadido a la lista de espera de Thunderbolt. Estamos trabajando para darte acceso lo antes posible. Te enviaremos otro correo cuando llegue tu turno."

#. js-lingui-explicit-id
#: src/emails/waitlist-joined.tsx
#: src/emails/waitlist-not-ready.tsx
#: src/emails/waitlist-reminder.tsx
msgid "The Thunderbolt Team"
msgstr "El equipo de Thunderbolt"

#. js-lingui-explicit-id
#: src/emails/waitlist-not-ready.tsx
msgid "Not quite ready yet!"
msgstr "¡Aún no está todo listo!"

#. js-lingui-explicit-id
#: src/emails/waitlist-not-ready.tsx
msgid "We noticed you tried to sign in to Thunderbolt. You're on our waitlist, but we're not quite ready for you yet. Don't worry — we're working hard to get you access as soon as possible. We'll send you an email when it's your turn to join."
msgstr "Vimos que intentaste iniciar sesión en Thunderbolt. Estás en nuestra lista de espera, pero todavía no estamos listos para ti. No te preocupes: estamos trabajando para darte acceso lo antes posible. Te enviaremos un correo cuando llegue tu turno."

#. js-lingui-explicit-id
#: src/emails/waitlist-reminder.tsx
msgid "You're already on the waitlist!"
msgstr "¡Ya estás en la lista de espera!"

#. js-lingui-explicit-id
#: src/emails/waitlist-reminder.tsx
msgid "Good news — you're already on the Thunderbolt waitlist. No need to sign up again! We're working hard to get you access as soon as possible. We'll send you an email when it's your turn to join."
msgstr "Buenas noticias: ya estás en la lista de espera de Thunderbolt. ¡No necesitas registrarte de nuevo! Estamos trabajando para darte acceso lo antes posible. Te enviaremos un correo cuando llegue tu turno."
