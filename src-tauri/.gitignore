# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Generated by SwiftPM, for plugins with a Swift half. Holds its own clones of
# the Swift dependencies, so leaving it untracked is not enough: git descends
# into those nested repos and `git status` dies on the first one SwiftPM has
# left without a reachable HEAD.
plugins/*/swift-lib/.build/

# Custom
.env
data/*

# Migrations
migration/target