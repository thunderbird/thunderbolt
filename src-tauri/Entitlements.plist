<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Associated Domains is restricted on macOS: the embedded provisioning
	     profile authorizes it only for this app and team, so the signature must
	     name both. Xcode adds these on its own; Tauri doesn't. -->
	<key>com.apple.application-identifier</key>
	<string>BUMSKVQ3D9.net.thunderbird.thunderbolt</string>
	<key>com.apple.developer.team-identifier</key>
	<string>BUMSKVQ3D9</string>
	<!-- Passkeys: associates the macOS app with app.thunderbolt.io so
	     ASAuthorization platform passkeys scope to that RP ID. Pairs with the
	     `webcredentials` block in public/.well-known/apple-app-site-association.
	     For local dev against a signed build, append `?mode=developer` and run
	     `swcutil developer-mode -e true` on the test Mac. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.thunderbolt.io</string>
	</array>
</dict>
</plist>
