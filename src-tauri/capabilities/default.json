{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main-webview permissions. Arbitrary HTTP(S) destinations are intentional for user-configured providers and MCP servers, including LAN endpoints. Accepted risk: scripts executing in this privileged webview can invoke native HTTP directly and read reachable public, loopback, private and link-local services, including metadata endpoints. Cloud Proxy and createProxyFetch are routing policy, not IPC security boundaries. Preview webviews receive no permission from this capability.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-default-window-icon",
    "opener:default",
    "os:default",
    "deep-link:default",
    "updater:default",
    "passkey:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-skip-taskbar",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-theme",
    "core:window:allow-set-effects",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-size",
    "core:webview:allow-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-webview-close",
    "core:webview:allow-webview-hide",
    "core:webview:allow-webview-show",
    "core:window:allow-destroy",
    "process:allow-exit",
    "process:allow-restart",
    "platform-utils:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*:*/*"
        },
        {
          "url": "https://*:*/*"
        }
      ]
    },
    "haptics:allow-selection-feedback",
    "haptics:allow-impact-feedback",
    "haptics:allow-notification-feedback",
    "haptics:allow-vibrate",
    "store:default",
    "fs:default",
    "fs:allow-app-write-recursive",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$DOWNLOAD/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$DOWNLOAD/*"
        }
      ]
    }
  ],
  "remote": {
    "urls": ["http://localhost:1420/*"]
  }
}
