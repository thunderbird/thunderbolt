// file, You can obtain one at http://mozilla.org/MPL/2.0/.
type Props = { kind: 'local' | 'confidential' };
const { kind } = Astro.props;
const local = kind === 'local';
---
<figure class="privacy-path-figure">
<svg class="privacy-path-illustration" viewBox="0 0 440 182" role="img" aria-label={local ? 'Thunderbolt and a local model both run inside infrastructure you control.' : 'Your device sends an encrypted request to a verified Tinfoil enclave. The model processes it inside the protected environment.'}>
  {local ? (
    <rect x="24" y="20" width="392" height="150" rx="24" class="path-boundary" />
  ) : (
    <rect x="252" y="20" width="164" height="150" rx="24" class="path-boundary" />
  )}
  <path d="M170 105H270" class="path-connection" />
  <rect x="60" y="64" width="110" height="78" rx="9" class="path-device" />
  <path d="M49 150h132M105 142v8M125 142v8" class="path-device-line" />
  <rect x="70" y="74" width="90" height="58" rx="4" class="path-screen" />
  <path d="m120 82-22 25h17l-6 20 24-29h-17z" class="path-bolt" />
  <rect x="286" y="65" width="96" height="80" rx="15" class="path-device" />
  <rect x="305" y="84" width="58" height="42" rx="8" class="path-screen" />
  <path d="M315 57v8m19-8v8m19-8v8m-38 80v8m19-8v8m19-8v8M278 86h8m-8 19h8m-8 19h8m96-38h8m-8 19h8m-8 19h8" class="path-device-line" />
  <path d="m322 110 9-12 8 12 8-12" class="path-model" />
  {!local && <g><circle cx="220" cy="105" r="17" class="path-lock-disc" /><rect x="213" y="104" width="14" height="11" rx="2" class="path-lock" /><path d="M216 104v-4a4 4 0 0 1 8 0v4" class="path-lock" /></g>}
</svg>
<figcaption><span>{local ? 'Thunderbolt' : 'Your device'}</span><span>{local ? 'Local model' : 'Verified enclave'}</span></figcaption>
</figure>
