---
// This Source Code Form is subject to the terms of the Mozilla Public
// License, v. 2.0. If a copy of the MPL was not distributed with this
// file, You can obtain one at http://mozilla.org/MPL/2.0/.
import '../styles/spark-editorial.css';
import '@fontsource-variable/lora';
import SiteHead from '../components/SiteHead.astro';
import { SparkHeader } from '../components/marketing/spark/spark-header';
import { SparkFooter } from '../components/marketing/spark/spark-footer';

type Props = {
	title: string;
	/** Override the formatted <title> tag. Defaults to `{title} · Thunderbolt`. */
	fullTitle?: string;
	description?: string;
	ogImage?: string;
	ogType?: 'website' | 'article';
};

const {
	title,
	fullTitle = `${title} · Thunderbolt`,
	description = 'News, updates, and insights from the Thunderbolt team.',
	ogImage = 'https://thunderbolt.io/social.png',
	ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="spark-site-theme">
	<head>
		<SiteHead title={fullTitle} {description} {ogImage} {ogType} />
	</head>
	<body>
		<a class="spark-skip" href="#main-content">Skip to content</a>
		<SparkHeader currentPage="Blog" client:load />
		<main id="main-content" class="spark-shell">
			<slot />
		</main>
		<div class="site-footer">
			<SparkFooter />
			<p class="legal spark-shell">
				Thunderbolt is a product of
				<a href="https://blog.thunderbird.net/2020/01/thunderbirds-new-home/">Thunderbird Technologies Corporation</a>,
				a wholly owned subsidiary of the not-for-profit Mozilla.org. &copy; {new Date().getFullYear()}.
				Content available under a
				<a href="https://www.mozilla.org/foundation/licensing/website-content/">Creative Commons license</a>.
			</p>
		</div>
	</body>
</html>

<style>
	main { flex: 1; padding-block: 64px 0; }
	.site-footer { margin-top: 96px; border-top: 1px solid var(--spark-border); }
	.legal { margin-block: 0 28px; color: var(--spark-muted); font-size: 11px; line-height: 1.7; }
	.legal a { text-underline-offset: 3px; }
	@media (max-width: 760px) {
		main { padding-top: 40px; }
		.site-footer { margin-top: 64px; }
	}
</style>
