---
// This Source Code Form is subject to the terms of the Mozilla Public
// License, v. 2.0. If a copy of the MPL was not distributed with this
// file, You can obtain one at http://mozilla.org/MPL/2.0/.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogArtwork from '../../components/blog/BlogArtwork.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [featured, ...otherPosts] = posts;
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---

<BaseLayout title="Blog" fullTitle="Thunderbolt — Blog" description="Product news, fresh ideas, and a more open future for AI. From the Thunderbolt team.">
  <header class="intro">
    <h1>Inside Thunderbolt<span>.</span></h1>
    <p>Product news, fresh ideas, and a more open future for AI.</p>
  </header>

  {featured && (
    <article class="featured">
      <a href={`/blog/${featured.id}/`} class="featured-link">
        <BlogArtwork image={featured.data.image} eager />
        <div class="featured-copy">
          <time datetime={featured.data.date.toISOString()}>{dateFormatter.format(featured.data.date)}</time>
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <span class="read-more">Read the story <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </article>
  )}

  <div class="post-grid">
    {otherPosts.map((post) => (
      <article>
        <a href={`/blog/${post.id}/`} class="post-card">
          <BlogArtwork image={post.data.image} />
          <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <span class="read-more">Read the story <span aria-hidden="true">→</span></span>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .intro { text-align: center; margin-bottom: 72px; }
  h1 { margin: 0; font-size: clamp(40px, 6vw, 76px); font-weight: 500; line-height: 1.12; letter-spacing: -.045em; }
  h1 span { color: var(--spark-red); }
  .intro p { margin: 24px 0 0; color: var(--spark-muted); font-size: 17px; line-height: 1.7; text-wrap: balance; }
  .featured-link { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 48px; text-decoration: none; }
  .featured-copy h2 { font-size: clamp(26px, 3vw, 38px); }
  time { display: block; color: var(--spark-muted); font-size: 13px; line-height: 1.5; }
  h2 { margin: 16px 0; font-size: 28px; line-height: 1.22; font-weight: 500; letter-spacing: -.035em; text-wrap: pretty; transition: color 150ms; }
  article p { margin: 0; color: var(--tb-text-secondary); font-size: 15px; line-height: 1.75; }
  .read-more { display: inline-flex; align-items: center; gap: 20px; margin-top: 24px; color: var(--spark-red); font-size: 14px; font-weight: 550; }
  article a:hover h2 { color: var(--spark-red); }
  .post-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 72px; padding-top: 56px; border-top: 1px solid var(--spark-border); }
  .post-card { display: block; text-decoration: none; }
  .post-card time { margin-top: 28px; }
  @media (max-width: 900px) { .featured-link, .post-grid { gap: 32px; } }
  @media (max-width: 760px) {
    .intro { margin-bottom: 48px; }
    .intro p { margin-top: 20px; font-size: 15px; }
    .featured-link, .post-grid { grid-template-columns: 1fr; gap: 28px; }
    .featured-copy h2 { font-size: 30px; }
    .post-grid { margin-top: 48px; padding-top: 40px; gap: 48px; }
    h2 { font-size: 26px; }
  }
</style>
