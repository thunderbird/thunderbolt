msgid "Sign in to Thunderbolt"
msgstr "Sign in to Thunderbolt"

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Use the code below to sign in, or click the button."
msgstr "Use the code below to sign in, or click the button."

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Sign In"
msgstr "Sign In"

