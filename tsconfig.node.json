{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "scripts/**/*.ts", "src/db/bundle-migrations.ts"],
  // Type-checked by the root tsconfig (strict, Bun types) so `bun run type-check` covers them.
  "exclude": ["scripts/qa", "scripts/notify-on-failure.ts"]
}
