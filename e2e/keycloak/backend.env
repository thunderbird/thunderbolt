# The backend for the local Keycloak validation stack: run from backend/ with
#   bun --env-file=../e2e/keycloak/backend.env src/index.ts
# Local test values only. NODE_ENV=test enables the fixed sign-in code and must never reach a
# deployment: deploy/docker/backend-image.test.ts and the Helm tests check the packaged ones.
NODE_ENV=test
PORT=8000
# IPv4 loopback, which Docker Desktop's host.docker.internal reaches (see scim-loopback).
HOST=127.0.0.1
LOG_LEVEL=INFO
AUTH_MODE=oidc
# The env connection `sso`, as an existing deployment has it, beside the realms an admin adds.
OIDC_ISSUER=http://localhost:8280/realms/legacy
OIDC_CLIENT_ID=thunderbolt-app
OIDC_CLIENT_SECRET=legacy-secret
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/thunderbolt
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=keycloak-validation-local-secret-0123456789
APP_URL=http://localhost:1420
TRUSTED_ORIGINS=http://localhost:1420,http://localhost:8280
CORS_ORIGINS=http://localhost:1420
BOOTSTRAP_ADMIN_EMAILS=admin@thunderbolt.test
# Off for the scenario suite, which signs in more often than the auth tier's 10 a minute allows.
# The load run turns it on (RATE_LIMIT_ENABLED=true) to measure the real SCIM budget.
RATE_LIMIT_ENABLED=false
POWERSYNC_URL=http://localhost:8080
POWERSYNC_JWT_SECRET=keycloak-validation-powersync-secret-32-chars
POWERSYNC_JWT_KID=keycloak-validation
